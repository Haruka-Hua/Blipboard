# Auto-detect text files and normalize line endings to LF across platforms
* text=auto eol=lf

# Explicitly enforce LF for shell and Python scripts
*.sh text eol=lf
*.py text eol=lf

# Enforce CRLF for Windows batch and PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary
*.dat binary
*.AppImage binary
*.pyc binary
